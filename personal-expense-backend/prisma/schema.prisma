generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id         String   @id
  email      String   @unique
  full_name  String?
  avatar_url String?
  currency   String?
  createdAt  DateTime @default(now())
  updated_at DateTime @updatedAt

  accounts      Account[]
  categories    Category[]
  transactions  Transaction[]
  transfers     Transfer[]
  budgets       Budget[]
  goals         Goal[]
  bills         Bill[]
  debt          Debt[]
  investment    Investment[]
  alert         Alert[]
  Recurring     Recurring[]
  Savings       SavingsChallenge[]
  preferences   Preferences?
  notifications Notification[]
  NetWorth      NetWorth[]
  Snapshot      NetWorthSnapshot[]
  importBatches ImportBatch[]
}

model Preferences {
  id       String @id @default(uuid())
  theme    String @default("light")
  language String @default("en")
  currency String @default("USD")
  user     User   @relation(fields: [userId], references: [id])
  userId   String @unique
}

model Notification {
  id        String   @id @default(uuid())
  type      String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
}

model Account {
  id            String   @id @default(uuid())
  name          String
  institution   String
  accountNumber String?
  type          String
  currency      String
  balance Decimal @db.Decimal(15, 2)
  userId        String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user         User              @relation(fields: [userId], references: [id])
  transactions Transaction[]
  Recurring    Recurring[]
  Snapshot     AccountSnapshot[]

  transfersFrom Transfer[] @relation("TransferFromAccount")
  transfersTo   Transfer[] @relation("TransferToAccount")
}

model AccountSnapshot {
  id         String           @id @default(uuid())
  accountId  String
  snapshotId String
  balance Decimal @db.Decimal(15, 2)
  account    Account          @relation(fields: [accountId], references: [id])
  snapshot   NetWorthSnapshot @relation(fields: [snapshotId], references: [id])
}

model Category {
  id           String        @id @default(uuid())
  name         String
  type         String
  color        String
  icon         String
  isDefault    Boolean
  userId       String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  user         User          @relation(fields: [userId], references: [id])
  transactions Transaction[]
  budgets      Budget[]
  Recurring    Recurring[]
}

model Transfer {
  id     String @id @default(uuid())
  userId String

  fromAccountId String
  toAccountId   String

  amount      Decimal @db.Decimal(15, 2)
  date        DateTime
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  fromAccount Account @relation("TransferFromAccount", fields: [fromAccountId], references: [id])

  toAccount Account @relation("TransferToAccount", fields: [toAccountId], references: [id])

  @@index([userId])
  @@index([fromAccountId])
  @@index([toAccountId])
}

model Transaction {
  id         String  @id @default(uuid())
  userId     String
  accountId  String
  categoryId String?

  type        String
  amount      Decimal @db.Decimal(15, 2)
  description String?
  date        DateTime

  source        String  @default("manual")
  importBatchId String?

  transferId        String?
  transferAccountId String?
  transferDirection String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  billId String?
  debtId String?
  goalId String?

  user        User         @relation(fields: [userId], references: [id])
  account     Account      @relation(fields: [accountId], references: [id])
  category    Category?    @relation(fields: [categoryId], references: [id])
  importBatch ImportBatch? @relation(fields: [importBatchId], references: [id])

  @@index([userId])
  @@index([userId, date])
  @@index([accountId])
  @@index([transferId])
  @@index([importBatchId])
}

model ImportBatch {
  id     String @id @default(uuid())
  userId String

  fileName String?
  source   String // csv | pdf | bank_statement
  status   String  @default("completed") // processing | completed | failed

  totalRows    Int @default(0)
  importedRows Int @default(0)
  skippedRows  Int @default(0)
  failedRows   Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
  @@index([userId, createdAt])
}

model Budget {
  id         String   @id @default(uuid())
  limit      Decimal @db.Decimal(15, 2)
  period     String
  startDate  DateTime
  userId     String
  categoryId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])
}

enum GoalStatus {
  active
  completed
  paused
}

model Goal {
  id            String     @id @default(uuid())
  userId        String
  name          String
  targetAmount  Decimal @db.Decimal(15, 2)
  currentAmount Decimal @default(0) @db.Decimal(15, 2)
  status        GoalStatus @default(active)
  startDate     DateTime
  endDate       DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model Debt {
  id             String   @id @default(uuid())
  userId         String
  name           String
  type           String
  creditor       String
  originalAmount Decimal @db.Decimal(15, 2)
  currentBalance Decimal @db.Decimal(15, 2)
  minimumPayment Decimal @db.Decimal(15, 2)
  interestRate   Float
  dueDay         Int
  startDate      DateTime
  notes          String
  status         String   @default("active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  payments DebtPayment[]

  user User @relation(fields: [userId], references: [id])
}

model DebtPayment {
  id     String   @id @default(uuid())
  debtId String
  amount Decimal @db.Decimal(15, 2)
  paidAt DateTime @default(now())

  debt Debt @relation(fields: [debtId], references: [id])

  @@index([debtId])
}

model Bill {
  id         String        @id @default(uuid())
  userId     String
  name       String
  amount     Decimal @db.Decimal(15, 2)
  dueDay     Int
  frequency  BillFrequency
  isPaid     Boolean       @default(false)
  lastPaidAt DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id])
}

enum BillFrequency {
  weekly
  monthly
  quarterly
  yearly
}

model Alert {
  id        String   @id @default(uuid())
  userId    String
  type      String // bill_due | low_balance | budget_exceeded | goal_completed | debt_due
  title     String
  message   String
  severity  String // info | warning | critical
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Investment {
  id            String    @id @default(uuid())
  userId        String
  name          String
  type          String
  provider      String?
  principal     Decimal @db.Decimal(15, 2)
  currentValue  Decimal @db.Decimal(15, 2)
  contribution  Decimal? @db.Decimal(15, 2)
  purchasePrice Decimal? @db.Decimal(15, 2)
  currentPrice  Decimal? @db.Decimal(15, 2)
  premium       Decimal? @db.Decimal(15, 2)
  sumAssured    Decimal? @db.Decimal(15, 2)
  startDate     DateTime
  notes         String?
  createdAt     DateTime  @default(now())
  symbol        String?
  quantity      Float?
  maturityDate  DateTime?

  user User @relation(fields: [userId], references: [id])

  @@map("investments")
}

model Recurring {
  id          String   @id @default(uuid())
  userId      String
  accountId   String
  description String
  amount      Decimal @db.Decimal(15, 2)
  type        String // "income" | "expense"
  categoryId  String
  frequency   String // "daily" | "weekly" | "monthly" | "yearly"
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id])
  account  Account  @relation(fields: [accountId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])

  @@index([userId])
  @@index([userId, startDate])
}

model SavingsChallenge {
  id     String @id @default(uuid())
  userId String

  name        String
  description String?

  targetAmount  Decimal @db.Decimal(15, 2)
  currentAmount Decimal @default(0) @db.Decimal(15, 2)

  startDate DateTime
  endDate   DateTime

  frequency   String? // daily | weekly | monthly (optional)
  isCompleted Boolean @default(false)
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model NetWorth {
  id        String             @id @default(uuid())
  userId    String
  date      DateTime           @default(now())
  value     Decimal @db.Decimal(15, 2)
  snapshots NetWorthSnapshot[]

  // relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model NetWorthSnapshot {
  id               String   @id @default(uuid())
  netWorthId       String
  userId           String
  date             DateTime @default(now())
  assets           Decimal @db.Decimal(15, 2)
  liabilities      Decimal @db.Decimal(15, 2)
  totalAssets      Decimal @db.Decimal(15, 2)
  totalLiabilities Decimal @db.Decimal(15, 2)
  cash             Decimal? @db.Decimal(15, 2)
  investments      Decimal? @db.Decimal(15, 2)
  debts            Decimal? @db.Decimal(15, 2)
  notes            String?

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  netWorth        NetWorth?         @relation(fields: [netWorthId], references: [id])
  AccountSnapshot AccountSnapshot[]

  @@index([userId])
}
